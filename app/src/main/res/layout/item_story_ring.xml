<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingEnd="12dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <View
                android:id="@+id/storyRingBorder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_gradient_stroke_grey"
                android:visibility="gone"
                tools:visibility="visible" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_grey_equal" />

            <ImageView
                android:id="@+id/imgAddBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_gradient_stroke_grey"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_add_story"
                android:visibility="gone"
                app:tint="@color/white"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/font_noto_sans"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="Bạn" />
    </LinearLayout>
</layout>
