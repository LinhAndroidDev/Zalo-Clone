<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pin"
        app:tint="@color/color_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPinnedPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Nội dung tin nhắn đã ghim" />

        <TextView
            android:id="@+id/tvPinnedBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Ghim bởi Nguyễn A" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgPinnedThumb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="8dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:src="@drawable/bg_grey_equal" />

    <ImageView
        android:id="@+id/imgDragHandle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/pinned_menu_sort"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_drag_handle"
        android:visibility="gone"
        app:tint="@color/text_subtle"
        tools:visibility="visible" />
</LinearLayout>
