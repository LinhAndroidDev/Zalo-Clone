<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_menu_compact"
    android:elevation="4dp"
    android:minWidth="120dp"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/btnCopy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/font_noto_sans"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingHorizontal="14dp"
        android:text="@string/diary_comment_menu_copy"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/font_noto_sans"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingHorizontal="14dp"
        android:text="@string/diary_comment_menu_edit"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/font_noto_sans"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingHorizontal="14dp"
        android:text="@string/diary_comment_menu_delete"
        android:textColor="@color/color_error"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
