<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Video của đối phương (toàn màn hình) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Avatar + tên + trạng thái (thoại, đang đổ chuông, chưa có video) -->
    <LinearLayout
        android:id="@+id/layoutInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="80dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_circle"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Tên + thời gian khi đang xem video -->
    <LinearLayout
        android:id="@+id/layoutVideoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvVideoName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVideoStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Video của mình (khung nhỏ) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localVideo"
        android:layout_width="108dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone" />

    <!-- Nút cho cuộc gọi đến -->
    <LinearLayout
        android:id="@+id/layoutIncomingControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="64dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnReject"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="64dp"
            android:background="@drawable/bg_call_end"
            android:contentDescription="@string/call_cd_reject"
            android:padding="20dp"
            android:src="@drawable/ic_call_end" />

        <ImageButton
            android:id="@+id/btnAccept"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="64dp"
            android:background="@drawable/bg_call_accept"
            android:contentDescription="@string/call_cd_accept"
            android:padding="20dp"
            android:src="@drawable/ic_call_accept" />
    </LinearLayout>

    <!-- Nút trong cuộc gọi -->
    <LinearLayout
        android:id="@+id/layoutCallControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="48dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_call_control"
                android:contentDescription="@string/call_cd_mic"
                android:padding="16dp"
                android:src="@drawable/ic_call_mic" />

            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_call_control"
                android:contentDescription="@string/call_cd_camera"
                android:padding="16dp"
                android:src="@drawable/ic_call_camera"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnFlip"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_call_control"
                android:contentDescription="@string/call_cd_flip"
                android:padding="16dp"
                android:src="@drawable/ic_call_flip"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_call_control"
                android:contentDescription="@string/call_cd_speaker"
                android:padding="16dp"
                android:src="@drawable/ic_call_speaker" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEnd"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_call_end"
            android:contentDescription="@string/call_cd_end"
            android:padding="20dp"
            android:src="@drawable/ic_call_end" />
    </LinearLayout>
</FrameLayout>
